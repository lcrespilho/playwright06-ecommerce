  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Program (tsx)",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/index.ts",
      "env": {
        "HEADLESS": "false",
        "DEVTOOLS": "false",
        "LOG": "true"
      }
    }
  ]
}
